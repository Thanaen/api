{
  "name": "api",
  "version": "1.0.50",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "module": "src/index.js",
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test test/cache.test.ts test/parsing.test.ts",
    "test:db": "bun test test/cache-repository.test.ts",
    "test:integration": "bun test test/endpoints.test.ts",
    "dev": "bun run --watch src/dev.ts",
    "build": "tsdown",
    "posthog:sourcemaps": "bun scripts/posthog-sourcemaps.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "lefthook install",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.16",
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "@sinclair/typebox": ">= 0.34.0 < 1",
    "drizzle-orm": "^0.45.4",
    "elysia": "latest",
    "node-html-parser": "^7.1.0",
    "posthog-node": "^5.59.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@posthog/cli": "^0.19.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^0.25.0",
    "tsdown": "^0.23.3"
  }
}
